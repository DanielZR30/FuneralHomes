{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "customersRoute": {
        "ClusterId": "customersCluster",
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/customers" } ]
      },
      "financialsRoute": {
        "ClusterId": "financialsCluster",
        "Match": { "Path": "/api/financials/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/financials" } ]
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:7036/" } }
      },
      "customersCluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:7035/" } }
      },
      "financialsCluster": {
        "Destinations": { "destination1": { "Address": "https://localhost:7037/" } }
      }
    }
  }
}
